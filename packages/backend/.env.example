# ==============================================================================
# AuraScholar Backend Environment Configuration Template
# Copy this file to .env and fill in your own credentials
# ==============================================================================

PORT=3001

# 1. Qwen ModelScope (Reasoning Model)
MODELSCOPE_BASE_URL=https://api-inference.modelscope.ai/v1
MODELSCOPE_API_KEY=your_modelscope_api_key_here
MODELSCOPE_MODEL=Qwen-Ambassador/Qwen3.8-Flash-Next

# 2. Google Gemini (Multimodal Analysis & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# 4. Supabase (PostgreSQL & pgvector Persistent Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_service_role_key

# 5. UploadThing (Cloud PDF CDN File Storage)
UPLOADTHING_TOKEN=your_uploadthing_token_here
UPLOADTHING_SECRET=your_uploadthing_secret_key
UPLOADTHING_APP_ID=your_uploadthing_app_id
